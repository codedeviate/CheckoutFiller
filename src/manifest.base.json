{
  "manifest_version": 3,
  "name": "CheckoutFiller",
  "version": "0.1.0",
  "description": "Fill checkout test credentials from the right-click menu. Fills, never submits.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "CheckoutFiller" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
